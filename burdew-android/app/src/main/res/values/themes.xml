<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Burdew" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/burdew_primary</item>
        <item name="colorPrimaryVariant">@color/burdew_primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/burdew_secondary</item>
        <item name="colorSecondaryVariant">@color/burdew_secondary</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">@color/burdew_background</item>
        <item name="android:windowBackground">@color/burdew_background</item>
        <item name="android:statusBarColor">@color/burdew_primary_dark</item>
    </style>

    <style name="Theme.Burdew.Splash" parent="Theme.Burdew">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/burdew_primary</item>
    </style>

    <style name="Burdew.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/burdew_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Burdew.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Burdew.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
