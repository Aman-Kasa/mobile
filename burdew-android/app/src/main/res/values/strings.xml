    <!-- Onboarding -->
    <string name="welcome">Welcome</string>
    <string name="get_started">Get started</string>
    <string name="onb_what_title">What BURDEW does</string>
    <string name="onb_what_body">BURDEW organises a local bill collection service. Customers ask for help paying their electricity or water bill, and a trusted service provider does it for them.</string>
    <string name="onb_how_title">How collection works</string>
    <string name="onb_how_body">A request comes in by SMS or is entered here. A provider visits the customer, collects the payment, pays at the utility office, photographs the official receipt and delivers it. Every step is recorded.</string>
    <string name="onb_map_title">GPS and offline maps</string>
    <string name="onb_map_body">Customer locations are saved with GPS or picked on an offline map of Asmara. Everything works without internet.</string>
    <string name="onb_privacy_title">Customer information is protected</string>
    <string name="onb_privacy_body">Data stays on this phone. Every operator signs in with their own password, providers only see their own work, and every change is logged.</string>

